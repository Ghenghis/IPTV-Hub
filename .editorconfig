root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.rs]
indent_size = 4

[*.py]
indent_size = 4

[*.{md,mmd}]
trim_trailing_whitespace = false

[*.{ps1,psm1}]
end_of_line = crlf
indent_size = 2

[Makefile]
indent_style = tab

[*.{json,toml,yaml,yml}]
indent_size = 2
