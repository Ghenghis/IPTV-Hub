# IPTV Hub — .gitignore

# Rust
/target/
**/target/
**/*.rs.bk
Cargo.lock.bak

# Frontend
/frontend/node_modules/
/frontend/dist/
/frontend/.vite/
/frontend/.eslintcache

# Tauri
/src-tauri/target/
/src-tauri/gen/
/src-tauri/WixTools/

# Local config / data
*.local
.env
.env.local
*.bak

# OS / editor
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.code-workspace
!.vscode/extensions.json

# Runtime artefacts (the apps_root tree is user data, never committed)
/logs/
/cache/
/data/
/iptv-hub.db
/iptv-hub.db-*

# Snapshots and packaged bundles
*.tar.zst
*.msi
*.exe
*.zip
*.dmg
*.AppImage
!schema/examples/*.json
