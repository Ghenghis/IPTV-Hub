# /opt/iptv-hub/secrets/authentik.env  (operator-managed, mode 0600, never in git)
#
# Lane: lane-cloud-pack. This .example is committed so the schema is
# visible. The real file lives on the operator laptop at
# ~/.iptv-hub-secrets/authentik.env and is synced via scripts/sync-secrets.sh.
#
# Generate values:
#   AUTHENTIK_SECRET_KEY        →  openssl rand -hex 32
#   AUTHENTIK_PG_PASS           →  openssl rand -base64 24
#   AUTHENTIK_BOOTSTRAP_TOKEN   →  openssl rand -hex 32
#   AUTHENTIK_BOOTSTRAP_PASSWORD→  openssl rand -base64 24

AUTHENTIK_SECRET_KEY=REPLACE_ME_64_HEX_CHARS
AUTHENTIK_PG_PASS=REPLACE_ME_RANDOM_PASSPHRASE
AUTHENTIK_BOOTSTRAP_TOKEN=REPLACE_ME_64_HEX_CHARS
AUTHENTIK_BOOTSTRAP_PASSWORD=REPLACE_ME_RANDOM_PASSPHRASE

# SMTP (Gmail app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=fnice1971@gmail.com
SMTP_APP_PASSWORD=REPLACE_ME_GMAIL_APP_PASSWORD
SMTP_FROM=IPTV Hub <fnice1971@gmail.com>
