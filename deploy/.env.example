# IPTV Hub — VPS deploy environment template.
#
# Copy this file to `deploy/.env` on the operator workstation and fill in the
# values. The `.env` itself is .gitignore'd. The same file is uploaded to the
# VPS as `/opt/iptv-hub/.env` by `scripts/deploy.py`.
#
# Credentials (VPS_HOST, VPS_USER, VPS_PASS) live SEPARATELY in
# `G:\private\.env.deploy` and are never put in this file.

# --- Public-facing domain that fronts the IPTV-Hub apps ---
# Each deployable app gets a subdomain `<app-id>.${DEPLOY_DOMAIN}` (subdomain
# mode) OR a path `/<app-id>/` under this domain (path mode). The host's
# existing nginx already terminates HTTPS via Cloudflare; we add new server
# blocks (or location blocks in path mode), not certificates.
DEPLOY_DOMAIN=daveai.tech

# --- Routing scheme ---
# `subdomain` (default) — each app at <app-id>.${DEPLOY_DOMAIN}.
# `path`              — each app at ${DEPLOY_DOMAIN}/<app-id>/.
# Subdomain is preferred (cleaner cookies, per-app cert scope).
ROUTING_SCHEME=subdomain

# --- VPS-side install path ---
# Where this repo's `deploy/` directory and the app data volumes live on the VPS.
# Created on first deploy if missing. Must be writable by VPS_USER.
VPS_INSTALL_ROOT=/opt/iptv-hub

# --- Per-app upload limit ---
# Forwarded into the nginx fragment's `client_max_body_size` directive.
CLIENT_MAX_MB=64

# --- Compose project name ---
# Prefix for every container/network/volume.
COMPOSE_PROJECT_NAME=iptv-hub

# --- Optional Basic Auth ---
# Apply HTTP Basic Auth at the nginx layer in addition to whatever the app does.
# Format: "user:bcrypt-hash" (use `htpasswd -B -n -b user pass | head -1`).
# Leave empty to disable.
GLOBAL_BASIC_AUTH=
