# /etc/nginx/sites-available/auth.daveai.tech.conf
#
# Lane: lane-cloud-pack. The auth gateway. This is the ONE subdomain that
# does NOT require authentication — it IS the authentication.
#
# Real IPs: yes (so the login audit log is meaningful).
# Auth gate: no (would be circular).

# WebSocket upgrade map — used by the proxy include but defined per-site so
# the directive lives in http{} scope as Nginx requires.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    listen [::]:80;
    server_name auth.daveai.tech;

    # Cloudflare is the source of truth for HTTPS at the edge; redirect
    # any leakage of HTTP traffic that somehow reached the origin.
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name auth.daveai.tech;

    # Wildcard cert covers this host. See doc 56.
    ssl_certificate     /etc/letsencrypt/live/daveai.tech-wildcard/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/daveai.tech-wildcard/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    # Real visitor IPs (lane-a-provider-registry).
    include /etc/nginx/cloudflare-real-ip.conf;

    # Increased body size for SAML responses and certificate uploads in the
    # admin UI. Authentik recommends 1m+.
    client_max_body_size 64m;

    access_log /var/log/nginx/auth.daveai.tech.access.log;
    error_log  /var/log/nginx/auth.daveai.tech.error.log warn;

    location / {
        proxy_pass http://127.0.0.1:9000;

        proxy_http_version 1.1;
        proxy_set_header   Upgrade            $http_upgrade;
        proxy_set_header   Connection         $connection_upgrade;
        proxy_set_header   Host               $host;
        proxy_set_header   X-Real-IP          $remote_addr;
        proxy_set_header   X-Forwarded-For    $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto  $scheme;
        proxy_set_header   X-Forwarded-Host   $http_host;

        proxy_buffering         off;
        proxy_request_buffering off;
        proxy_read_timeout      300s;
        proxy_send_timeout      300s;
        proxy_connect_timeout   10s;
    }
}
