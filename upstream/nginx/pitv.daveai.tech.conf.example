# /etc/nginx/sites-available/pitv.daveai.tech.conf
#
# Lane: lane-cloud-pack. Mirrors the pitv container at 127.0.0.1:8003.
#
# Authentication: required (family-members or family-admins).
# Real IPs: yes.

server {
    listen 80;
    listen [::]:80;
    server_name pitv.daveai.tech;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name pitv.daveai.tech;

    ssl_certificate     /etc/letsencrypt/live/daveai.tech-wildcard/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/daveai.tech-wildcard/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;

    include /etc/nginx/cloudflare-real-ip.conf;
    include /etc/nginx/auth-gate.conf;

    client_max_body_size 256m;     # M3U playlists can be large
    access_log /var/log/nginx/pitv.daveai.tech.access.log;
    error_log  /var/log/nginx/pitv.daveai.tech.error.log warn;

    location / {
        auth_request /outpost.goauthentik.io/auth/nginx;
        error_page 401 = @authentik_login;

        include /etc/nginx/iptv-app-proxy.conf;
        proxy_pass http://127.0.0.1:8003;
    }
}
