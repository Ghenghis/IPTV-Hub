{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IPTV Hub",
  "version": "0.1.0",
  "identifier": "com.iptvhub.app",

  "build": {
    "beforeDevCommand": "npm --workspace=frontend run dev",
    "beforeBuildCommand": "npm --workspace=frontend run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },

  "app": {
    "windows": [
      {
        "label": "main",
        "title": "IPTV Hub",
        "width": 1080,
        "height": 760,
        "minWidth": 920,
        "minHeight": 600,
        "resizable": true,
        "decorations": true,
        "transparent": false,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost",
      "dangerousDisableAssetCspModification": false
    }
  },

  "bundle": {
    "active": true,
    "category": "Utility",
    "copyright": "Copyright © 2026 ShadowByte. All rights reserved.",
    "targets": ["msi", "nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "wix": {
        "language": ["en-US"]
      }
    },
    "shortDescription": "Unified launcher and update manager for IPTV apps.",
    "longDescription": "IPTV Hub launches and safely updates 25+ IPTV / streaming applications side-by-side on Windows 11. Manifest-driven sources, snapshot rollback for every update, user data never touched."
  },

  "plugins": {
    "updater": {
      "active": false
    }
  }
}
